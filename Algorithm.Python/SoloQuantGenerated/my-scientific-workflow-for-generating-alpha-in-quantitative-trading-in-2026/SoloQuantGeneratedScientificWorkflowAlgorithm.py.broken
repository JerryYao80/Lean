from AlgorithmImports import *

class SoloQuantGeneratedScientificWorkflowAlgorithm(QCAlgorithm):
    def Initialize(self):
        # 1. 账户设置
        self.SetAccountCurrency("CNY")
        self.SetCash(100000)
        self.SetBenchmark(lambda x: 0)
        
        # 2. 时间设置 (优先读取参数，若无则使用默认值)
        start_date_str = self.GetParameter("start-date")
        if start_date_str:
            self.SetStartDate(DateTime.ParseExact(start_date_str, "yyyyMMdd", None))
        else:
            self.SetStartDate(2000, 1, 1)
            
        end_date_str = self.GetParameter("end-date")
        if end_date_str:
            self.SetEndDate(DateTime.ParseExact(end_date_str, "yyyyMMdd", None))
        else:
            self.SetEndDate(2026, 1, 18)
            
        # 3. 添加标的 (A股)
        # 示例使用贵州茅台 (600519.SSE) 作为单一标的演示
        self.symbol = self.AddEquity("600519.SSE", Resolution.Daily, Market.SSE).Symbol
        
        # 4. 设置A股特定模型
        security = self.Securities[self.symbol]
        security.FeeModel = AShareStockFeeModel()
        security.FillModel = AShareStockFillModel()
        security.BuyingPowerModel = AShareStockBuyingPowerModel()
        security.SettlementModel = DelayedSettlementModel(1, timedelta(hours=9))
        
        # 5. 指标与因子 (使用动量作为未公开因子的占位符)
        self.lookback_period = 20
        self.momentum = self.MOM(self.symbol, self.lookback_period, Resolution.Daily)
        
        # 6. 风控参数
        self.max_drawdown = 0.20  # 最大回撤 20%
        self.trailing_stop_pct = 0.05 # 移动止损 5%
        self.highest_portfolio_value = self.Portfolio.TotalPortfolioValue
        self.highest_price_since_entry = 0

    def OnData(self, slice):
        if not self.Securities[self.symbol].HasData:
            return

        # --- 风控模块 ---
        
        # 1. 最大回撤检查
        current_value = self.Portfolio.TotalPortfolioValue
        if current_value > self.highest_portfolio_value:
            self.highest_portfolio_value = current_value
            
        drawdown = (self.highest_portfolio_value - current_value) / self.highest_portfolio_value
        if drawdown > self.max_drawdown:
            if self.Portfolio[self.symbol].Invested:
                self.Liquidate(self.symbol)
                self.highest_price_since_entry = 0
            return

        # 如果未持仓，跳过移动止损逻辑
        if not self.Portfolio[self.symbol].Invested:
            pass
        else:
            # 2. 移动止损检查
            current_price = self.Securities[self.symbol].Price
            if current_price > self.highest_price_since_entry:
                self.highest_price_since_entry = current_price
                
            if current_price < self.highest_price_since_entry * (1 - self.trailing_stop_pct):
                self.Liquidate(self.symbol)
                self.highest_price_since_entry = 0
                return

        # --- 交易逻辑模块 ---
        
        # 确保指标已准备好
        if not self.momentum.IsReady:
            return

        # 获取因子值 (这里使用动量作为示例)
        factor_value = self.momentum.Current.Value
        
        # 简单的阈值策略 (示例)
        buy_threshold = 0.0
        sell_threshold = 0.0
        
        holdings = self.Portfolio[self.symbol].Quantity
        
        # 买入逻辑
        if holdings <= 0 and factor_value > buy_threshold:
            # 计算目标数量 (100股取整)
            target_value = self.Portfolio.TotalPortfolioValue * 0.95
            price = self.Securities[self.symbol].Price
            raw_quantity = target_value / price
            quantity = int(raw_quantity / 100) * 100
            
            if quantity > 0:
                self.MarketOrder(self.symbol, quantity)
                self.highest_price_since_entry = price # 初始化移动止损基准
        
        # 卖出逻辑 (因子反转)
        elif holdings > 0 and factor_value < sell_threshold:
            self.Liquidate(self.symbol)
            self.highest_price_since_entry = 0