          "query": "SELECT last(\"source_type\") AS source_type, last(\"status_code\") AS status_code, last(\"crawled_count\") AS crawled, last(\"duplicate_count\") AS dup, last(\"screened_count\") AS screened, last(\"avg_lag_minutes\") AS avg_lag, last(\"avg_weight_score\") AS avg_weight FROM \"soloquant_crawl_source\" WHERE $timeFilter GROUP BY \"source_name\"",
